+test('headless full Chromium preserves its hidden window and produces exact first JPEGs for small and large virtual viewports', { timeout: 30000 }, async () => {
+  const browser = await chromium.launch({ channel: 'chromium', headless: true });
+  const cases = [];
+  try {
+    const page = await browser.newPage();
+    await page.setContent('<style>html,body{margin:0;background:rgb(255,0,0)}</style>');
+    const client = page._connection.toImpl(page).delegate._mainFrameSession._client;
+    const { windowId } = await client.send('Browser.getWindowForTarget');
+    for (const size of [{ width: 320, height: 240 }, { width: 1440, height: 900 }, { width: 64, height: 64 }]) {
+      const before = (await client.send('Browser.getWindowBounds', { windowId })).bounds;
+      const send = client.send;
+      let bounds = 0, metrics = 0;
+      client.send = async function (method, ...args) {
+        if (method === 'Browser.setWindowBounds') {
+          bounds++;
+          await new Promise(resolve => setTimeout(resolve, 100));
+        }
+        if (method === 'Emulation.setDeviceMetricsOverride') metrics++;
+        return Reflect.apply(send, this, [method, ...args]);
+      };
+      try { await page.setViewportSize(size); }
+      finally { client.send = send; }
