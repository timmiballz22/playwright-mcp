+      assert.deepEqual(await page.evaluate(() => ({ width: innerWidth, height: innerHeight })), size);
+      const after = (await client.send('Browser.getWindowBounds', { windowId })).bounds;
+      assert.deepEqual({ width: after.width, height: after.height }, { width: before.width, height: before.height });
+      assert.equal(bounds, 0); assert.equal(metrics, 1);
+      const image = PNG.sync.read(await page.screenshot({ timeout: 5000 }));
+      assert.equal(image.width, size.width); assert.equal(image.height, size.height);
+      const offset = (Math.min(100, size.height - 1) * image.width + Math.min(100, size.width - 1)) * 4;
+      assert.deepEqual([...image.data.subarray(offset, offset + 4)], [255, 0, 0, 255]);
+      cases.push({ ...size, firstInput, hiddenWindowWidth: after.width, hiddenWindowHeight: after.height, bounds, metrics, redPixel: true });
+    }
+    console.log(JSON.stringify({ fixture: 'chromium_headless_virtual_viewports', platform: process.platform, engine: 'chromium', channel: 'chromium', cases }));
   } finally { await browser.close(); }
 });
